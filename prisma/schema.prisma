// Prisma schema — Sistema de Control Bancario y Casino
// Ver ESPECIFICACION_APP_CONTROL_BANCARIO.md secciones 2, 3 y 4.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth / roles
// ---------------------------------------------------------------------------

enum Rol {
  ADMIN
  OPERADOR
  /// resuelve incidencias de cuentas existentes y agenda apertura de cuentas nuevas
  GESTOR
}

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol
  // Letra asignada al operador (A, B, C...). Null para ADMIN/GESTOR (ven todas).
  letra     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  seguimientosReportados Seguimiento[] @relation("SeguimientoOperador")
  seguimientosAsignados  Seguimiento[] @relation("SeguimientoResponsable")
  aperturasAsignadas     Apertura[]

  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// 2.1 Cuentas (bancarias)
// ---------------------------------------------------------------------------

enum StatusCuenta {
  POR_VERIFICAR
  ACTIVA
  BLOQUEADA
  BAJA
  SIN_ACCESO
}

enum TipoCuenta {
  BASICA
  SIN_LIMITE
  MEJORADA
}

model Cuenta {
  /// formato `banco.letra.perfil`, ej `sant.a.101`
  id         String       @id
  status     StatusCuenta @default(POR_VERIFICAR)
  /// Null = pendiente de definir (aún no se confirma con el cliente/banco).
  tipoCuenta TipoCuenta?  @map("tipo_cuenta")
  letra      String
  perfil     String
  banco      String

  saldoInicial Decimal @map("saldo_inicial") @db.Decimal(14, 2)

  clabe           String?
  usuario         String?
  contrasena      String?
  nuevaContrasena String? @map("nueva_contrasena")
  token           String?
  nip             String?

  nCuenta      String? @map("n_cuenta")
  nCliente     String? @map("n_cliente")
  nombrePerfil String? @map("nombre_perfil")

  // Datos de tarjeta asociada (ver también pantalla 5.7 Tarjetas)
  nTarjeta          String? @map("n_tarjeta")
  exp               String?
  cvv               String?
  ubicacionCustodia String? @map("ubicacion_custodia")

  observaciones String?
  prestadaA     String? @map("prestada_a")

  idCliente     String?  @map("id_cliente")
  nombreCliente String?  @map("nombre_cliente")
  clienteActivo Boolean  @default(false) @map("cliente_activo")
  cliente       Cliente? @relation(fields: [idCliente], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movimientos       Movimiento[]
  casinosCobranAqui Casino[]     @relation("CasinoCobraEnCuenta")
  saldosDiarios     SaldoDiario[]
  seguimientos      Seguimiento[]

  @@index([letra])
  @@index([status])
  @@index([idCliente])
  @@map("cuentas")
}

/// Foto diaria del saldo de una cuenta (una fila por cuenta por día), para
/// poder calcular el promedio mensual real y detectar riesgo de comisión por
/// fondeo bajo. Se llena vía un cron diario (ver /api/cron/snapshot-saldos).
model SaldoDiario {
  id       Int      @id @default(autoincrement())
  cuentaId String   @map("cuenta_id")
  cuenta   Cuenta   @relation(fields: [cuentaId], references: [id])
  fecha    DateTime @db.Date
  saldo    Decimal  @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([cuentaId, fecha])
  @@index([fecha])
  @@map("saldos_diarios")
}

// ---------------------------------------------------------------------------
// Clientes (catálogo real: identidad + datos operativos)
// ---------------------------------------------------------------------------

model Cliente {
  /// formato CL0001
  id             String  @id
  status         String?
  nombreCompleto String  @map("nombre_completo")

  // Datos personales / identidad
  direccionIne    String?   @map("direccion_ine")
  ciudad          String?
  estado          String?
  cp              String?
  curp            String?
  rfc             String?
  fechaNacimiento DateTime? @map("fecha_nacimiento")
  expIne          Int?      @map("exp_ine")
  idmx            String?
  noIne           String?   @map("no_ine")

  // Contacto
  telefono         String?
  whatsapp         String?
  nombreReferencia String? @map("nombre_referencia")
  noReferencia     String? @map("no_referencia")
  ingresoPor       String? @map("ingreso_por")

  // Datos operativos
  /// letra.perfil asignado, ej "a-101"
  equipo              String?
  /// operador asignado (nombre/alias)
  opera               String?
  correoOperativo     String?   @map("correo_operativo")
  contrasenaOperativa String?   @map("contrasena_operativa")
  noLinea             String?   @map("no_linea")
  telefonia           String?
  validacion          String?
  ultRecarga          DateTime? @map("ult_recarga")
  apertura            String?
  fechaRegistro       DateTime? @map("fecha_registro")
  nota                String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cuentas      Cuenta[]
  seguimientos Seguimiento[]
  aperturas    Apertura[]

  @@index([nombreCompleto])
  @@map("clientes")
}

// ---------------------------------------------------------------------------
// 2.2 Casinos
// ---------------------------------------------------------------------------

enum StatusCasino {
  ACTIVO
  BLOQUEADO
  ALERTA
}

enum StatusPerfil {
  VERIFICADO
  EN_PROCESO
  SIN_VERIFICACION
}

model Casino {
  /// formato `casino.letra.perfil`, ej `code.a.101`
  id           String @id
  noCasino     Int    @map("no_casino")
  nombreCasino String @map("nombre_casino")
  letra        String
  perfil       String

  saldoInicial Decimal @map("saldo_inicial") @db.Decimal(14, 2)

  statusCasino StatusCasino @map("status_casino")
  statusPerfil StatusPerfil @map("status_perfil")

  usuario    String?
  contrasena String?

  /// si es true, un depósito a este casino debe venir del banco del mismo cliente (solo advertencia, no bloquea)
  requiereMismoCliente Boolean @default(false) @map("requiere_mismo_cliente")

  /// cuenta bancaria donde se retira ese casino
  cobraEnId String?
  cobraEn   Cuenta? @relation("CasinoCobraEnCuenta", fields: [cobraEnId], references: [id])

  nota String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apuestas     Apuesta[]
  reglasBono   ReglaBono[]
  seguimientos Seguimiento[]

  @@index([letra])
  @@index([statusCasino])
  @@map("casinos")
}

// ---------------------------------------------------------------------------
// 2.3 Movimientos (bancarios)
// ---------------------------------------------------------------------------

enum TipoMovimiento {
  DEPOSITO_A_CASINO
  RETIRO_DE_CASINO
  PRESTAMO_ENTRE_CUENTAS
  GASTO_OPERATIVO
}

/// Dirección contable del movimiento respecto a `cuenta_id`.
enum DireccionMovimiento {
  RETIRO
  DEPOSITO
}

enum EstadoMovimiento {
  CONFIRMADO
  PENDIENTE
  CANCELADO
}

model Movimiento {
  id             Int            @id @default(autoincrement())
  fecha          DateTime       @default(now())
  tipoMovimiento TipoMovimiento @map("tipo_movimiento")

  cuentaId String
  cuenta   Cuenta @relation(fields: [cuentaId], references: [id])

  tipo  DireccionMovimiento
  monto Decimal             @db.Decimal(14, 2)

  estado EstadoMovimiento @default(CONFIRMADO)

  /// ID de casino o de otra cuenta (lado contrario del movimiento).
  /// Referencia polimórfica intencional (Casino.id o Cuenta.id) — no es FK de Prisma.
  casinoUOrigen String? @map("casino_u_origen")

  concepto      String?
  referencia    String?
  notas         String?
  registradoPor String  @map("registrado_por")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([cuentaId])
  @@index([casinoUOrigen])
  @@index([tipoMovimiento])
  @@index([fecha])
  @@map("movimientos")
}

// ---------------------------------------------------------------------------
// 2.4 Apuestas
// ---------------------------------------------------------------------------

enum Mercado {
  LOCAL
  EMPATE
  VISITANTE
}

enum StatusApuesta {
  EN_JUEGO
  GANADA
  PERDIDA
}

/// Freebet: si ganas, no se regresa el capital apostado. Dinero: se comporta como efectivo normal.
enum TipoBonoApuesta {
  FREEBET
  DINERO
}

model Apuesta {
  id     Int      @id @default(autoincrement())
  fecha  DateTime @default(now())
  letra  String
  perfil String

  casinoId String
  casino   Casino @relation(fields: [casinoId], references: [id])

  noApuesta   String? @map("no_apuesta")
  evento      String
  mercado     Mercado
  descripcion String?
  momio       Decimal @db.Decimal(8, 3)

  saldoReal Decimal @map("saldo_real") @db.Decimal(14, 2)
  bono      Decimal @default(0) @db.Decimal(14, 2)
  /// tipo del monto en `bono`: freebet (no regresa el capital al ganar) o dinero (se comporta como efectivo)
  tipoBono  TipoBonoApuesta? @map("tipo_bono")

  /// si esta apuesta cuenta para el rollover de un reclamo de bono específico
  reclamoBonoId Int?         @map("reclamo_bono_id")
  reclamoBono   BonoReclamo? @relation(fields: [reclamoBonoId], references: [id])

  /// = momio × (saldo_real + bono)
  posibleGanancia Decimal @map("posible_ganancia") @db.Decimal(14, 2)

  statusApuesta StatusApuesta @default(EN_JUEGO) @map("status_apuesta")

  /// monto real que se acredita cuando se marca Ganada
  resultadoGanancia Decimal? @map("resultado_ganancia") @db.Decimal(14, 2)

  /// si este registro es la ganancia generada al cerrar una apuesta, referencia a la apuesta original
  apuestaRelacionadaId  Int?      @map("apuesta_relacionada_id")
  apuestaRelacionada    Apuesta?  @relation("ApuestaGanancia", fields: [apuestaRelacionadaId], references: [id])
  gananciasRelacionadas Apuesta[] @relation("ApuestaGanancia")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([casinoId])
  @@index([letra])
  @@index([statusApuesta])
  @@index([reclamoBonoId])
  @@map("apuestas")
}

// ---------------------------------------------------------------------------
// 2.5 Promociones / Bonos por casino
// ---------------------------------------------------------------------------

enum TipoBono {
  /// se puede pedir una vez por mes, hasta cierto día del mes
  DEPOSITO_MES
  /// se puede volver a pedir cada N días desde el último reclamo
  CADA_N_DIAS
  /// una sola vez (ej. bono de bienvenida)
  BIENVENIDA
}

/// Reglas de una promoción de un casino (ej. "Bono cada 25 días" de Codere).
model ReglaBono {
  id       Int    @id @default(autoincrement())
  casinoId String @map("casino_id")
  casino   Casino @relation(fields: [casinoId], references: [id])

  nombre String
  tipo   TipoBono

  /// para DEPOSITO_MES: día límite del mes para calificar (ej. 15)
  diaCorteMes Int? @map("dia_corte_mes")
  /// para CADA_N_DIAS: cada cuántos días se puede volver a solicitar (ej. 25)
  cadaDias Int? @map("cada_dias")

  /// para BIENVENIDA: momio mínimo requerido para liberar el bono (formato decimal, ej. 1.5)
  momioMinimo Decimal? @map("momio_minimo") @db.Decimal(8, 3)
  /// monto mínimo de apuesta para liberar el bono
  montoMinimo Decimal? @map("monto_minimo") @db.Decimal(14, 2)

  /// si se define, el bono = monto depositado × este multiplicador (ej. 2 = el doble), en vez de buscar en la tabla de tiers
  multiplicador Decimal? @db.Decimal(6, 3)
  /// depósito mínimo para calificar cuando se usa `multiplicador` (los tiers ya definen su propio mínimo por rango)
  depositoMinimo Decimal? @map("deposito_minimo") @db.Decimal(14, 2)
  /// tope máximo del bono otorgado cuando se usa `multiplicador` (ej. hasta $8,600)
  bonoMaximo Decimal? @map("bono_maximo") @db.Decimal(14, 2)
  /// veces que hay que jugar (depósito + bono) antes de poder retirar (ej. 3 = rollover 3X). Solo referencia, no se rastrea automáticamente.
  rolloverMultiplicador Decimal? @map("rollover_multiplicador") @db.Decimal(6, 3)

  activo Boolean @default(true)
  notas  String?

  tiers    BonoTier[]
  reclamos BonoReclamo[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([casinoId])
  @@map("reglas_bono")
}

/// Tabla de depósito → bono de una regla (ej. depositas 400, te dan 800 en freebet).
model BonoTier {
  id      Int       @id @default(autoincrement())
  reglaId Int       @map("regla_id")
  regla   ReglaBono @relation(fields: [reglaId], references: [id], onDelete: Cascade)

  depositoMin Decimal  @map("deposito_min") @db.Decimal(14, 2)
  /// null = sin tope superior
  depositoMax Decimal? @map("deposito_max") @db.Decimal(14, 2)
  bonoMonto   Decimal  @map("bono_monto") @db.Decimal(14, 2)

  @@index([reglaId])
  @@map("bono_tiers")
}

/// Historial de veces que se ha reclamado un bono — resetea el conteo de la cadencia.
model BonoReclamo {
  id      Int       @id @default(autoincrement())
  reglaId Int       @map("regla_id")
  regla   ReglaBono @relation(fields: [reglaId], references: [id], onDelete: Cascade)

  fecha         DateTime @default(now())
  monto         Decimal  @db.Decimal(14, 2)
  bonoOtorgado  Decimal  @map("bono_otorgado") @db.Decimal(14, 2)
  registradoPor String   @map("registrado_por")

  /// (monto + bonoOtorgado) × rolloverMultiplicador de la regla al momento del reclamo; null = sin rollover
  rolloverRequerido Decimal? @map("rollover_requerido") @db.Decimal(14, 2)
  /// true si ya se completó el rollover (calculado o marcado a mano por el admin)
  rolloverLiberado  Boolean  @default(false) @map("rollover_liberado")

  apuestas Apuesta[]

  @@index([reglaId])
  @@map("bono_reclamos")
}

// ---------------------------------------------------------------------------
// Seguimiento (incidencias/trámites de clientes existentes) y Aperturas
// (agenda de cuentas nuevas por abrir) — pantallas del rol Gestor.
// ---------------------------------------------------------------------------

enum PrioridadSeguimiento {
  BAJA
  MEDIA
  ALTA
}

enum EstadoSeguimiento {
  PENDIENTE
  COMPLETADO
}

model Seguimiento {
  id        Int                  @id @default(autoincrement())
  titulo    String
  /// categoría libre de gestión (ej. "Actualización de datos", "Actualización de fotos", "Otros")
  tipo      String
  prioridad PrioridadSeguimiento @default(MEDIA)
  estado    EstadoSeguimiento    @default(PENDIENTE)

  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  /// operador que reporta/envía la incidencia (no la asigna, solo la levanta)
  operadorId String?  @map("operador_id")
  operador   Usuario? @relation("SeguimientoOperador", fields: [operadorId], references: [id])

  /// quien la resuelve, asignado por Gestión
  responsableId String?  @map("responsable_id")
  responsable   Usuario? @relation("SeguimientoResponsable", fields: [responsableId], references: [id])

  fechaEntrega DateTime? @map("fecha_entrega")

  casinoInvolucradoId String? @map("casino_involucrado_id")
  casinoInvolucrado   Casino? @relation(fields: [casinoInvolucradoId], references: [id])

  bancoInvolucradoId String? @map("banco_involucrado_id")
  bancoInvolucrado   Cuenta? @relation(fields: [bancoInvolucradoId], references: [id])

  cantidadInvolucrada Decimal? @map("cantidad_involucrada") @db.Decimal(14, 2)

  notas     String?
  creadoPor String  @map("creado_por")

  avances SeguimientoAvance[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([estado])
  @@index([clienteId])
  @@index([operadorId])
  @@index([responsableId])
  @@index([fechaEntrega])
  @@map("seguimientos")
}

/// Historial de avance de un Seguimiento: notas con fecha para ver el progreso completo.
model SeguimientoAvance {
  id            Int         @id @default(autoincrement())
  seguimientoId Int         @map("seguimiento_id")
  seguimiento   Seguimiento @relation(fields: [seguimientoId], references: [id], onDelete: Cascade)

  fecha         DateTime @default(now())
  descripcion   String
  registradoPor String   @map("registrado_por")

  @@index([seguimientoId])
  @@map("seguimiento_avances")
}

enum EstadoApertura {
  AGENDADA
  REALIZADA
  CANCELADA
}

model Apertura {
  id            Int    @id @default(autoincrement())
  nombreCliente String @map("nombre_cliente")
  telefono      String?
  letra         String?

  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  /// qué se va a abrir (ej. "Codere", "Santander")
  bancoOCasino String @map("banco_o_casino")

  fechaCita DateTime @map("fecha_cita")

  responsableId String?  @map("responsable_id")
  responsable   Usuario? @relation(fields: [responsableId], references: [id])

  notas  String?
  estado EstadoApertura @default(AGENDADA)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([estado])
  @@index([fechaCita])
  @@index([clienteId])
  @@map("aperturas")
}
